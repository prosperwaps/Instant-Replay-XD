{
  "name": "cbc-school-ecosystem",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/office",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w apps/office",
    "build": "npm run build -w apps/office",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "check": "npm run typecheck && npm run lint && npm run test"
  },
  "engines": {
    "node": ">=20.19"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "eslint": "9.39.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "5.2.0",
    "globals": "16.5.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0",
    "vitest": "4.1.12",
    "vite": "7.3.7"
  },
  "overrides": {
    "vite": "7.3.7"
  }
}
